{
  "compilerOptions": {
    "module": "NodeNext",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "functions/lib",
    "rootDir": "functions/src",
    "sourceMap": true,
    "strict": true,
    "target": "ESNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "typeRoots": [
      "./functions/types",
      "./node_modules/@types"
    ],
    "types": [
      "node",
      "jest",
      "emoji-data",
      "unicode__unicode-14.0.0"
    ],
    "moduleResolution": "NodeNext"
  },
  "compileOnSave": true,
  "include": [
    "functions/src"
  ]
}
